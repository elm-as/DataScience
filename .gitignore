# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Datasets & Heavy Artifacts (Never commit raw datasets or large model binaries)
**/data/raw/*.csv
**/data/raw/*.parquet
**/data/raw/*.zip
**/data/processed/*.parquet
**/data/processed/*.feather
**/artifacts/oof/*.npy
**/artifacts/test/*.npy
**/artifacts/models/*.pkl
**/artifacts/models/*.cbm
**/artifacts/models/*.txt
**/submissions/*.csv

# Keep directory structures via .gitkeep
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
!**/artifacts/oof/.gitkeep
!**/artifacts/test/.gitkeep
!**/submissions/.gitkeep

# Secrets & Credentials
.env
*.env
kaggle.json
**/kaggle.json

